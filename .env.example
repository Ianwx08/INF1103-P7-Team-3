GEMINI_API_KEY=your_gemini_api_key
# Optional: GEMINI_MODEL, DATA_DIR, STORAGE_BACKEND

# Email the admins at startup about high-value found items unclaimed for more than 7 days.
# Off unless STARTUP_EMAIL_ENABLED=true.
STARTUP_EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Lost & Found"
# Admin email addresses, separated by commas. All appear in To.
BREVO_RECIPIENTS=
